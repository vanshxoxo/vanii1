# Browser-safe configuration (local .env.local and Vercel Preview/Production)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase Edge Function secrets (Supabase Dashboard > Edge Functions > Secrets)
SUPABASE_ENVIRONMENT=preview
STOREFRONT_ORIGIN=https://YOUR_PREVIEW_DOMAIN.vercel.app

# Razorpay secrets (server side only; leave disabled until verified end to end)
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
PAYMENTS_MODE=test
PAYMENTS_LIVE_ENABLED=false
PAYMENTS_LIVE_WEBHOOK_VERIFIED=false

# Shiprocket API secrets (server side only)
SHIPROCKET_EMAIL=REPLACE_WITH_API_USER_EMAIL
SHIPROCKET_PASSWORD=REPLACE_ME
SHIPROCKET_PICKUP_LOCATION=REPLACE_WITH_CONFIGURED_PICKUP_NAME
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=20
SHIPROCKET_DEFAULT_BREADTH_CM=15
SHIPROCKET_DEFAULT_HEIGHT_CM=5

# Cloudinary media secrets (Supabase Edge Function secrets only; never VITE_* or Vercel browser vars)
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_API_KEY
CLOUDINARY_API_SECRET=REPLACE_ME

# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# automatically to Edge Functions. Never expose the service-role key in VITE_*.
