# Browser-safe Supabase settings (local .env.local and Vercel Config)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Vercel server-side ImageKit settings (private key is a Secret)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/qtqsvefdx
IMAGEKIT_PUBLIC_KEY=YOUR_IMAGEKIT_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=YOUR_IMAGEKIT_PRIVATE_KEY

# Supabase Edge Function secrets; Supabase supplies SUPABASE_URL,
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
SUPABASE_ENVIRONMENT=preview
# Exact comma-separated origins for browser requests to Supabase Edge Functions.
# Include the stable Preview domain and Production only when both should be allowed.
STOREFRONT_ORIGINS=https://YOUR_PREVIEW_DOMAIN.vercel.app
# Legacy alternative: STOREFRONT_ORIGIN=https://YOUR_PREVIEW_DOMAIN.vercel.app

# Razorpay is disabled until real credentials and webhook are verified.
# Keep unset to keep payment checkout unavailable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_MODE=test
PAYMENTS_LIVE_ENABLED=false
PAYMENTS_LIVE_WEBHOOK_VERIFIED=false

# Shiprocket Edge Function secrets. Configure only when account details exist.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=20
SHIPROCKET_DEFAULT_BREADTH_CM=15
SHIPROCKET_DEFAULT_HEIGHT_CM=5
